{
  "name": "serialport-stream-rs",
  "version": "0.1.0",
  "description": "Async serial port I/O for Node.js, backed by the serialport-stream Rust crate",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkki-silvola/serialport-stream-rs.git",
    "directory": "bindings"
  },
  "keywords": ["serialport", "serial", "uart", "napi-rs"],
  "main": "wrapper.js",
  "types": "wrapper.d.ts",
  "files": ["wrapper.js", "wrapper.d.ts", "index.js", "index.d.ts", "*.node"],
  "engines": {
    "node": ">= 16"
  },
  "napi": {
    "binaryName": "serialport-stream-rs",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  }
}
